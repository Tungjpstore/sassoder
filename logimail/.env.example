# LogiMail local example. Khong commit secret that.
LOGIMAIL_ENV=development
LOGIMAIL_DEPLOYMENT_MODE=shared-logivn-vps
LOGIMAIL_DOMAIN=logivn.com
LOGIMAIL_MAIL_HOSTNAME=mail.logivn.com
LOGIMAIL_SMTP_HOSTNAME=mail.logivn.com
LOGIMAIL_IMAP_HOSTNAME=mail.logivn.com
LOGIMAIL_APP_HOSTNAME=mail.logivn.com
LOGIMAIL_API_HOSTNAME=mail.logivn.com
LOGIMAIL_PUBLIC_URL=https://mail.logivn.com
LOGIMAIL_API_BASE_PATH=/api/logimail
LOGIMAIL_WEBMAIL_PATH=/roundcube/
LOGIMAIL_VPS_IP=103.199.19.144
LOGIMAIL_WEB_PORT=3000
LOGIMAIL_API_PORT=8787
LOGIMAIL_INTERNAL_API_KEY=

# Supabase. Uu tien project rieng cho LogiMail.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Cloudflare API token scope hep: Zone:Read + DNS:Edit cho logivn.com.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# BillionMail / mail engine. Chi dung server-side.
BILLIONMAIL_BASE_URL=http://127.0.0.1:8081
BILLIONMAIL_API_KEY=
BILLIONMAIL_HOSTNAME=mail.logivn.com
BILLIONMAIL_REVERSE_PROXY_DOMAIN=https://mail.logivn.com
BILLIONMAIL_INSTALL_DIR=/opt/BillionMail
BILLIONMAIL_HTTP_PORT=8081
BILLIONMAIL_HTTPS_PORT=8443
BILLIONMAIL_SQL_PORT=127.0.0.1:25432
BILLIONMAIL_REDIS_PORT=127.0.0.1:26379

# Encryption key server-side cho mailbox/API metadata neu can.
LOGIMAIL_SECRET_KEY=
LOGIMAIL_CREDENTIAL_ENCRYPTION_KEY=
LOGIMAIL_PUSH_WORKER_INTERVAL_MS=45000
LOGIMAIL_WEB_PUSH_PUBLIC_KEY=
LOGIMAIL_WEB_PUSH_PRIVATE_KEY=
LOGIMAIL_WEB_PUSH_SUBJECT=mailto:postmaster@logivn.com

# Ops/Telegram optional.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOGIMAIL_TELEGRAM_MODE=direct
LOGIMAIL_PLATFORM_ALERTS_ENABLED=false
LOGIMAIL_PLATFORM_ALERT_FORWARD_URL=https://api.logivn.com/events
LOGIMAIL_PLATFORM_ALERT_FORWARD_KEY=
LOGIMAIL_BACKUP_DIR=/var/backups/logimail
LOGIMAIL_BACKUP_REMOTE=disabled
LOGIMAIL_BACKUP_ENCRYPTION_KEY=
BACKUP_STORAGE_ADAPTER=worker
BACKUP_R2_GATEWAY_URL=
BACKUP_R2_GATEWAY_TOKEN=
R2_BUCKET=logivn-backups
BACKUP_R2_PREFIX=logimail
LOGIMAIL_AGENT_KILL_SWITCH=/etc/logimail/agent-disabled

# Chi dung neu LogiMail can queue rieng tren Redis/BullMQ. Khong dung chung prefix logivn.
LOGIMAIL_REDIS_URL=
BULLMQ_PREFIX=logimail
