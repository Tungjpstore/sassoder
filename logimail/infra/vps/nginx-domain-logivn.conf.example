# Nginx template for the LogiMail Control Center host.
# The mail host template defines the shared `map`, `upstream logimail_web`, and
# `upstream logimail_api` blocks. Load that template before this server block.

server {
  listen 80;
  listen [::]:80;
  server_name domain.logivn.com;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name domain.logivn.com;

  ssl_certificate /etc/letsencrypt/live/domain.logivn.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/domain.logivn.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 25m;
  proxy_buffer_size 64k;
  proxy_buffers 16 64k;
  proxy_busy_buffers_size 128k;
  large_client_header_buffers 8 32k;

  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Port 443;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $logimail_connection_upgrade;
  proxy_http_version 1.1;

  location = /api/logimail/health {
    proxy_pass http://logimail_api;
  }

  location /api/logimail/ {
    proxy_pass http://logimail_web;
  }

  location / {
    proxy_pass http://logimail_web;
  }
}
