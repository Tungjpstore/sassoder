# Dedicated RFC 8461 policy host. Keep this host DNS-only in Cloudflare so the
# ACME certificate and policy response terminate on the LogiMail VPS.
server {
  listen 80;
  listen [::]:80;
  server_name mta-sts.logivn.com;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name mta-sts.logivn.com;

  ssl_certificate /etc/letsencrypt/live/mta-sts.logivn.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/mta-sts.logivn.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location = /.well-known/mta-sts.txt {
    alias /opt/logimail/current/apps/logimail-web/public/.well-known/mta-sts.txt;
    default_type text/plain;
    add_header Cache-Control "public, max-age=300" always;
  }

  location / {
    return 404;
  }
}
