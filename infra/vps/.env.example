# Copy to /opt/logivn/.env on the VPS. Never commit the real file.
LOGIVN_ENV=production
TZ=Asia/Ho_Chi_Minh
NEXT_PUBLIC_APP_URL=https://logivn.com
LOGIVN_API_PUBLIC_URL=https://api.logivn.com
LOGIVN_WS_PUBLIC_URL=https://ws.logivn.com
LOGIVN_ALLOWED_ORIGINS=https://logivn.com,https://app.logivn.com

# Internal service auth. Generate with: openssl rand -base64 48
LOGIVN_INTERNAL_API_KEY=

# Redis. Generate with: openssl rand -base64 48
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# Supabase remains the primary database/auth/storage layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI provider routing and fallbacks.
AI_PROVIDER_FALLBACK_ORDER=qwen,xai,openai,claude
AI_PROVIDER_TIMEOUT_MS=45000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.2-mini
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_CHAT_MODEL=grok-4-mini
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01

# Telegram operations bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Service tuning.
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb
WORKER_CONCURRENCY=4
GATEWAY_PORT=3100
SOCKET_PORT=3200
AI_SERVICE_PORT=3300
IMAGE_SERVICE_PORT=3400
WORKER_PORT=3500
TELEGRAM_BOT_PORT=3600

# Monitoring. Set these before first Grafana boot.
GF_SECURITY_ADMIN_USER=logivn-admin
GF_SECURITY_ADMIN_PASSWORD=

# Certbot.
LETSENCRYPT_EMAIL=ops@logivn.com
SSL_DOMAINS=api.logivn.com,ws.logivn.com,worker.logivn.com,monitor.logivn.com
