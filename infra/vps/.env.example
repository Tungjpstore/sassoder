# Copy to /opt/logivn/.env on the VPS. Never commit the real file.
LOGIVN_ENV=production
TZ=Asia/Ho_Chi_Minh
NEXT_PUBLIC_APP_URL=https://logivn.com
LOGIVN_API_PUBLIC_URL=https://api.logivn.com
LOGIVN_API_INTERNAL_URL=http://gateway:3100
LOGIVN_APP_INTERNAL_URL=https://logivn.com
LOGIVN_WS_PUBLIC_URL=https://ws.logivn.com
LOGIVN_SOCKET_ALLOW_PUBLIC_CLIENTS=false
LOGIVN_ALLOWED_ORIGINS=https://logivn.com,https://app.logivn.com

# Internal service auth. Generate with: openssl rand -base64 48
LOGIVN_INTERNAL_API_KEY=

# Optional app cron handoff from Vercel Cron to VPS cron.
# Keep disabled while Vercel crons are active to avoid duplicate scheduled work.
CRON_SECRET=
LOGIVN_VPS_APP_CRONS_ENABLED=false
LOGIVN_VPS_APP_CRONS_LOG_SKIPS=false
LOGIVN_APP_CRON_BASE_URL=https://logivn.com
LOGIVN_APP_CRON_TIMEOUT_SECONDS=70
LOGIVN_DEPLOY_BACKUP_ENABLED=auto

# Automated backup & disaster recovery.
# BACKUP_ENCRYPTION_KEY and BACKUP_METADATA_SIGNING_KEY must be long, separate
# secrets and must not be stored in the backup bucket.
BACKUP_ENABLED=true
BACKUP_ENVIRONMENT=prod
BACKUP_TIMEZONE=Asia/Ho_Chi_Minh
BACKUP_DAILY_CRON="0 2 * * *"
BACKUP_WEEKLY_CRON="0 3 * * 0"
BACKUP_MONTHLY_CRON="0 4 1 * *"
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12
BACKUP_RETENTION_MANUAL=14
BACKUP_TEMP_DIR=/var/backups/logivn/tmp
BACKUP_ENCRYPTION_KEY=
BACKUP_METADATA_SIGNING_KEY=
BACKUP_STORAGE_PAYLOAD_ENABLED=auto
BACKUP_STORAGE_PAYLOAD_MODES=weekly,monthly,manual
BACKUP_STORAGE_BUCKETS=
BACKUP_STORAGE_EXCLUDE_BUCKETS=
BACKUP_STORAGE_LIST_LIMIT=1000
BACKUP_STORAGE_MAX_OBJECTS=50000
BACKUP_STORAGE_MAX_BYTES=0
BACKUP_RESTORE_TEST_ENABLED=true
BACKUP_RESTORE_TEST_MODE=list
RESTORE_TEST_DATABASE_URL=

# Supabase Postgres backup source. DATABASE_URL can be used instead.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
BACKUP_POSTGRES_DUMP_RUNNER=docker
BACKUP_POSTGRES_DOCKER_IMAGE=postgres:17-alpine

# Cloudflare R2 backup destination. Use the Worker gateway when possible so the
# VPS does not need long-lived R2 S3 credentials. Keep the S3-compatible fields
# below as a fallback adapter.
BACKUP_STORAGE_ADAPTER=worker
BACKUP_R2_GATEWAY_URL=
BACKUP_R2_GATEWAY_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=logivn-backups
R2_ENDPOINT=
R2_REGION=auto
BACKUP_R2_PREFIX=logivn

# Dev Telegram backup reporting. Uses PLATFORM_TELEGRAM_BOT_TOKEN by default.
DEV_TELEGRAM_CHAT_ID=
DEV_TELEGRAM_ALERTS_ENABLED=true
BACKUP_TELEGRAM_BOT_TOKEN=

# Redis. Generate with: openssl rand -base64 48
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_MAXMEMORY=1gb
BULLMQ_PREFIX=logivn
BULL_BOARD_ENABLED=false
BULL_BOARD_BASE_PATH=/queues/board
BULL_BOARD_USERNAME=logivn-ops
BULL_BOARD_PASSWORD=

# Supabase remains the primary database/auth/storage layer.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Staff attendance hardening. Generate each secret separately with: openssl rand -base64 48
STAFF_ATTENDANCE_QR_SECRET=
STAFF_ATTENDANCE_SESSION_SECRET=
STAFF_ATTENDANCE_TRUST_PROXY_HEADERS=false
STAFF_PIN_PEPPER=

# AI provider routing and fallbacks.
AI_PROVIDER_FALLBACK_ORDER=qwen,xai,openai,claude
AI_PROVIDER_TIMEOUT_MS=45000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.2-mini
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_CHAT_MODEL=grok-4-mini
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01

# Telegram operations bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CALLBACK_SECRET=
TELEGRAM_CONNECT_TOKEN_SECRET=
TELEGRAM_CONNECT_TOKEN_TTL_SECONDS=0
TELEGRAM_SESSION_SECRET=
TELEGRAM_SESSION_TTL_SECONDS=300
TELEGRAM_TENANT_PICKER_MAX_OPTIONS=8
TELEGRAM_CONNECT_RATE_LIMIT_MAX=8
TELEGRAM_CONNECT_RATE_LIMIT_WINDOW_MS=60000
TELEGRAM_WEBHOOK_SECRET=
# Must end with /webhooks/telegram/$TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_WEBHOOK_URL=https://api.logivn.com/webhooks/telegram/CHANGE_ME
TELEGRAM_WORKER_CONCURRENCY=4
TELEGRAM_RATE_LIMIT_MAX=24
TELEGRAM_RATE_LIMIT_DURATION_MS=1000
TELEGRAM_CALLBACK_RATE_LIMIT_MAX=30
TELEGRAM_CALLBACK_RATE_LIMIT_WINDOW_MS=60000
TELEGRAM_SEND_INTERVAL_MS=75
TELEGRAM_MAX_RETRY_AFTER_MS=300000
TELEGRAM_MAX_RETRY_DELAY_MS=120000
TELEGRAM_AI_OPS_RATE_LIMIT_MAX=8
TELEGRAM_AI_OPS_RATE_LIMIT_WINDOW_MS=60000
TELEGRAM_AI_OPS_TIMEOUT_MS=45000

# Telegram DevOps bot. Separate from tenant owner/staff bot.
# Use this for LogiVN internal platform alerts, queue/DLQ checks, and support operations.
PLATFORM_TELEGRAM_BOT_TOKEN=
PLATFORM_TELEGRAM_BOT_USERNAME=
PLATFORM_TELEGRAM_WEBHOOK_SECRET=
# Must end with /webhooks/platform-telegram/$PLATFORM_TELEGRAM_WEBHOOK_SECRET.
PLATFORM_TELEGRAM_WEBHOOK_URL=https://api.logivn.com/webhooks/platform-telegram/CHANGE_ME
PLATFORM_TELEGRAM_SESSION_SECRET=
PLATFORM_TELEGRAM_CONNECT_TOKEN_SECRET=
PLATFORM_TELEGRAM_CONNECT_TOKEN_TTL_SECONDS=0
PLATFORM_AI_SECRET_KEY=
# Use either a one-time bootstrap token or a comma-separated allowlist of Telegram user IDs.
PLATFORM_TELEGRAM_BOOTSTRAP_TOKEN=
PLATFORM_TELEGRAM_ALLOWED_USER_IDS=
PLATFORM_TELEGRAM_WORKER_CONCURRENCY=2
PLATFORM_TELEGRAM_RATE_LIMIT_MAX=12
PLATFORM_TELEGRAM_RATE_LIMIT_DURATION_MS=1000
PLATFORM_TELEGRAM_CALLBACK_RATE_LIMIT_MAX=20
PLATFORM_TELEGRAM_CALLBACK_RATE_LIMIT_WINDOW_MS=60000
PLATFORM_TELEGRAM_CONNECT_RATE_LIMIT_MAX=8
PLATFORM_TELEGRAM_CONNECT_RATE_LIMIT_WINDOW_MS=60000
PLATFORM_TELEGRAM_SEND_INTERVAL_MS=100
PLATFORM_TELEGRAM_SESSION_TTL_SECONDS=300
PLATFORM_GRAFANA_URL=https://monitor.logivn.com/grafana/
PLATFORM_BULL_BOARD_URL=https://monitor.logivn.com/queues/board/
OPERATIONAL_OUTBOX_RELAY_ENABLED=true
OPERATIONAL_OUTBOX_RELAY_INTERVAL_MS=5000
OPERATIONAL_OUTBOX_RELAY_BATCH_SIZE=25
OPERATIONAL_OUTBOX_RELAY_MAX_ATTEMPTS=12
OPERATIONAL_OUTBOX_RELAY_LOCK_SECONDS=120
OPERATIONAL_OUTBOX_RELAY_BACKOFF_MS=30000
OPERATIONAL_OUTBOX_RELAY_BACKOFF_MAX_MS=900000
ORDERS_SLA_SCANNER_ENABLED=true
ORDERS_SLA_SCANNER_INTERVAL_MS=60000
ORDERS_SLA_SCANNER_BATCH_SIZE=80
ORDERS_SLA_WARNING_MINUTES=10
ORDERS_SLA_WARNING_REPEAT_MINUTES=15
PUSH_NOTIFICATION_WEBHOOK_URL=
EMAIL_NOTIFICATION_WEBHOOK_URL=
ALERT_WEBHOOK_FORWARD_URL=
ALERT_WEBHOOK_FORWARD_TOKEN=

# Service tuning.
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb
QUEUE_CONCURRENCY=4
WORKER_CONCURRENCY=4
GATEWAY_PORT=3100
SOCKET_PORT=3200
AI_SERVICE_PORT=3300
IMAGE_SERVICE_PORT=3400
WORKER_PORT=3500
TELEGRAM_BOT_PORT=3600
PLATFORM_TELEGRAM_BOT_PORT=3650

# Monitoring. Set these before first Grafana boot.
GF_SECURITY_ADMIN_USER=logivn-admin
GF_SECURITY_ADMIN_PASSWORD=
GF_SERVER_ROOT_URL=https://monitor.logivn.com/grafana/

# Certbot.
LETSENCRYPT_EMAIL=ops@logivn.com
SSL_DOMAINS=api.logivn.com,ws.logivn.com,worker.logivn.com,monitor.logivn.com
