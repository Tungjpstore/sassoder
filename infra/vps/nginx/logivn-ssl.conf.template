map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}

limit_req_zone $binary_remote_addr zone=logivn_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=logivn_worker:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=logivn_monitor:10m rate=2r/s;

upstream logivn_gateway {
  server 127.0.0.1:3100;
  keepalive 32;
}

upstream logivn_socket {
  server 127.0.0.1:3200;
  keepalive 32;
}

upstream logivn_worker {
  server 127.0.0.1:3500;
  keepalive 16;
}

upstream logivn_telegram {
  server 127.0.0.1:3600;
  keepalive 16;
}

upstream logivn_uptime_kuma {
  server 127.0.0.1:3001;
  keepalive 16;
}

upstream logivn_grafana {
  server 127.0.0.1:3002;
  keepalive 16;
}

server {
  listen 80;
  listen [::]:80;
  server_name api.logivn.com ws.logivn.com worker.logivn.com monitor.logivn.com;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name api.logivn.com;

  ssl_certificate /etc/letsencrypt/live/api.logivn.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.logivn.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  gzip on;
  gzip_types application/json text/plain text/css application/javascript;
  client_max_body_size 20m;

  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location = /metrics {
    return 404;
  }

  location = /alerts {
    return 404;
  }

  location /webhooks/telegram/ {
    limit_req zone=logivn_api burst=20 nodelay;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 75s;
    proxy_pass http://logivn_telegram;
  }

  location / {
    limit_req zone=logivn_api burst=40 nodelay;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 75s;
    proxy_pass http://logivn_gateway;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name ws.logivn.com;

  ssl_certificate /etc/letsencrypt/live/ws.logivn.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/ws.logivn.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location = /metrics {
    return 404;
  }

  location / {
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    proxy_pass http://logivn_socket;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name worker.logivn.com;

  ssl_certificate /etc/letsencrypt/live/worker.logivn.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/worker.logivn.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 10m;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location = /metrics {
    return 404;
  }

  location / {
    limit_req zone=logivn_worker burst=20 nodelay;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://logivn_worker;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name monitor.logivn.com;

  ssl_certificate /etc/letsencrypt/live/monitor.logivn.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/monitor.logivn.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  add_header X-Robots-Tag "noindex, nofollow" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location = /health {
    access_log off;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://logivn_uptime_kuma;
  }

  location = /queues/board {
    return 301 /queues/board/;
  }

  location /queues/board/ {
    auth_basic "LogiVN queue operations";
    auth_basic_user_file /etc/nginx/.htpasswd-logivn-monitor;
    limit_req zone=logivn_monitor burst=10 nodelay;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://logivn_gateway;
  }

  location /grafana/ {
    auth_basic "LogiVN monitoring";
    auth_basic_user_file /etc/nginx/.htpasswd-logivn-monitor;
    limit_req zone=logivn_monitor burst=10 nodelay;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /grafana;
    proxy_pass http://logivn_grafana;
  }

  location / {
    auth_basic "LogiVN monitoring";
    auth_basic_user_file /etc/nginx/.htpasswd-logivn-monitor;
    limit_req zone=logivn_monitor burst=10 nodelay;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://logivn_uptime_kuma;
  }
}
