PRODUCTION_SMOKE_RESTAURANT_SLUG="demo-pho"
PRODUCTION_SMOKE_TIMEOUT_MS="15000"
# Responsive smoke defaults for local QA and pre-release verification.
RESPONSIVE_SMOKE_BASE_URL="http://127.0.0.1:3000"
RESPONSIVE_SMOKE_ROUTES="/,/pricing,/blog,/dashboard/login,/dashboard/register"
RESPONSIVE_SMOKE_VIEWPORTS="mobile-390:390x844,mobile-414:414x896,mobile-430:430x932,tablet-768:768x1024,desktop-1024:1024x768"
# Optional local-only authenticated dashboard smoke. Use the same random value for both variables.
# This bypass is ignored in production and only works when DASHBOARD_SMOKE_AUTH_SECRET is set on the Next.js server.
DASHBOARD_SMOKE_AUTH_SECRET=""
RESPONSIVE_SMOKE_AUTH_COOKIE_NAME="logivn-dashboard-smoke"
RESPONSIVE_SMOKE_AUTH_SECRET=""
RESPONSIVE_SMOKE_AUTH_RESTAURANT_SLUG="demo-pho"
# CopilotKit streaming timeout in milliseconds.
COPILOTKIT_TIMEOUT_MS="18000"
PLATFORM_ADMIN_PASSWORD="change-this-in-production"
PLATFORM_ADMIN_SESSION_SECRET="use-a-long-random-secret"
AUTH_RATE_LIMIT_SECRET="use-a-separate-long-random-secret"
MARKETING_FUNNEL_SECRET="use-a-separate-long-random-secret"
MARKETING_WAITLIST_NOTIFY_ENABLED="false"
MARKETING_WAITLIST_NOTIFY_TO="growth@logivn.com"
MARKETING_EMAIL_FROM="LogiVN Growth <growth@logivn.com>"
# Pepper riêng cho hash/lookup PIN nhân sự. Production phải đặt chuỗi dài, riêng với auth/admin secrets.
STAFF_PIN_PEPPER="use-a-separate-long-random-secret"
VIETQR_BANK="VCB"
VIETQR_ACCOUNT="1234567890"
VIETQR_ACCOUNT_NAME="Demo Restaurant"
# Secret used to sign table QR access tokens when token enforcement is enabled.
TABLE_QR_ACCESS_SECRET="use-a-long-random-secret"
# Tài khoản thu phí SaaS của LogiVN được chỉnh trong /admin -> Website -> Tài khoản VietQR của LogiVN.
# Ba biến VIETQR_* phía trên chỉ là fallback kỹ thuật cho luồng thanh toán đơn/cọc nếu quán chưa cấu hình ngân hàng riêng.

# Chỉ dùng khi chạy scripts/configure-supabase-auth.mjs.
