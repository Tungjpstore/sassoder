NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PLATFORM_ADMIN_PASSWORD="change-this-in-production"
PLATFORM_ADMIN_SESSION_SECRET="use-a-long-random-secret"
AUTH_RATE_LIMIT_SECRET="use-a-separate-long-random-secret"
VIETQR_BANK="VCB"
VIETQR_ACCOUNT="1234567890"
VIETQR_ACCOUNT_NAME="Demo Restaurant"
# Tài khoản thu phí SaaS của LogiVN được chỉnh trong /admin -> Website -> Tài khoản VietQR của LogiVN.
# Ba biến VIETQR_* phía trên chỉ là fallback kỹ thuật cho luồng thanh toán đơn/cọc nếu quán chưa cấu hình ngân hàng riêng.

# Chỉ dùng khi chạy scripts/configure-supabase-auth.mjs.
# Không cần đưa các biến này lên Vercel, vì SMTP/Google OAuth nằm trong Supabase Auth.
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_ACCESS_TOKEN="sbp_your-supabase-access-token"
SUPABASE_SMTP_HOST="smtp.example.com"
SUPABASE_SMTP_PORT="587"
SUPABASE_SMTP_USER="your-smtp-user"
SUPABASE_SMTP_PASS="your-smtp-password"
SUPABASE_SMTP_ADMIN_EMAIL="no-reply@your-domain.com"
SUPABASE_SMTP_SENDER_NAME="LogiVN"
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"
MAPBOX_ACCESS_TOKEN="your-mapbox-access-token"

# Vercel Cron + email báo cáo định kỳ
CRON_SECRET="generate-a-long-random-secret"
RESEND_API_KEY="re_your-resend-api-key"
REPORT_EMAIL_FROM="LogiVN <reports@logivn.com>"
BILLING_EMAIL_FROM="LogiVN <billing@logivn.com>"

# AI provider keys. Chỉ dùng ở server/Vercel env, tuyệt đối không expose ra client.
QWEN_API_KEY="sk-your-qwen-dashscope-key"
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"
COPILOTKIT_MODEL="qwen-plus"
QWEN_NATIVE_BASE_URL="https://dashscope-intl.aliyuncs.com"
XAI_API_KEY="xai-your-api-key"
XAI_BASE_URL="https://api.x.ai/v1"
XAI_MODEL="grok-3-mini-beta"
AI_OWNER_PROVIDER="qwen"
AI_CUSTOMER_PROVIDER="qwen"
AI_IMAGE_PROVIDER="xai"
AI_IMAGE_ALLOW_PROMPT_FALLBACK="false"
QWEN_OCR_MODEL="qwen-vl-ocr"
QWEN_IMAGE_MODEL="qwen-image-2.0-pro"
XAI_IMAGE_MODEL="grok-imagine-image"
